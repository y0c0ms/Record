// The left column: the flow being recorded, its controls, and the recordings
// tree — every folder, its sub-folders, and the recordings each holds.
//
// There used to be two lists of the same recordings: the tree, and a flat
// "Recordings" list under it. The tree is now the only place a flow is listed,
// and filing a flow is an action on the folder it should go in rather than a
// dropdown that repeated the folder list a third time.

import { Theme, Btn, Pill, Field, Label, Hint, Divider, Dot } from "theme.slint";
import { FolderRow } from "models.slint";
import { ScrollView } from "std-widgets.slint";

// One recording inside a folder: its name, a dot while it is being recorded or
// replayed, and a delete button.
component RecordingLeaf inherits Rectangle {
    in property <FolderRow> entry;
    in property <bool> deletable: true;
    callback open(string);
    callback delete(string);

    height: 26px;
    border-radius: Theme.r-md;
    background: root.entry.selected ? Theme.surface : touch.has-hover ? Theme.surface-2 : transparent;

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.entry.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.entry.selected;
    accessible-description: root.entry.tip;
    accessible-action-default => { root.open(root.entry.recording-id); }

    touch := TouchArea { clicked => { root.open(root.entry.recording-id); } mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 2px;
        spacing: 6px;
        Dot {
            tone: root.entry.live == "recording" ? Theme.danger : root.entry.live == "replaying" ? Theme.accent : Theme.text-dim;
            filled: root.entry.live != "";
            y: (parent.height - self.height) / 2;
            accessible-role: AccessibleRole.none;
        }
        Text {
            text: root.entry.name;
            color: root.entry.selected ? Theme.text : Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: AccessibleRole.none;
        }
        if root.deletable: Btn {
            compact: true; has-icon: true; icon: @image-url("icons/trash.svg");
            tone: Theme.danger; tip: "Delete " + root.entry.name;
            y: (parent.height - self.height) / 2;
            clicked => { root.delete(root.entry.recording-id); }
        }
    }
    // When it was captured, its length and how often it has run.
    Tooltip { text: @markdown("\{root.entry.tip}"); }
}

export component Sidebar inherits Rectangle {
    in-out property <string> flow-name;
    in property <string> demo-url;
    in property <bool> can-edit-flow: true;
    in property <bool> can-record: true;
    in property <bool> interrupting: false;
    in property <string> pause-label;
    in property <string> stop-hint;
    in property <bool> can-replay: false;
    in property <bool> can-export: false;
    in property <bool> has-session: false;
    in property <string> session-name;
    in property <string> session-summary;
    in property <color> session-summary-tone;
    // The flow being recorded or replayed; the tree may not be edited then.
    in property <bool> recording-live: false;
    // The folder the open flow is filed in, as shown next to the session line.
    in property <string> filed-under;

    in-out property <string> search;
    in property <[FolderRow]> folders;

    in property <bool> folder-draft-open: false;
    in property <bool> folder-draft-renaming: false;
    in-out property <string> folder-draft-name;

    callback use-demo();
    callback flow-name-edited(string);
    callback start-recording();
    callback interrupt();
    callback stop();
    callback replay();
    callback export-spec();
    callback search-edited(string);
    callback reload();
    // Selecting a folder shows only it; an empty id shows everything.
    callback folder-select(string);
    callback folder-toggle(string);
    callback new-folder();
    callback folder-draft-save();
    callback folder-draft-cancel();
    callback folder-draft-edited(string);
    callback folder-new-child(string);
    callback folder-rename(string);
    callback folder-delete(string);
    // Files the open flow into this folder.
    callback folder-file(string);
    callback recording-open(string);
    callback recording-delete(string);

    width: 340px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Text { text: "Session"; color: Theme.text; font-size: 15px; font-weight: 600; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Flow name"; color: Theme.text-dim; font-size: 12.5px; vertical-alignment: center; }
            Field {
                text <=> root.flow-name;
                placeholder: "Checkout happy path";
                label: "Flow name";
                enabled: root.can-edit-flow;
                horizontal-stretch: 1;
                edited(t) => { root.flow-name-edited(t); }
            }
            if root.demo-url != "": Btn {
                text: "Use demo";
                enabled: root.can-edit-flow;
                tip: "Start the next recording on the demo page";
                clicked => { root.use-demo(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Btn {
                text: "Start recording";
                has-icon: true;
                icon: @image-url("icons/record.svg");
                tone: Theme.ok;
                enabled: root.can-record;
                tip: "Open a browser and record what you do";
                clicked => { root.start-recording(); }
            }
            Btn {
                text: root.pause-label;
                has-icon: true;
                icon: root.pause-label == "Resume" ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                enabled: root.interrupting;
                clicked => { root.interrupt(); }
            }
            Btn {
                text: "Stop";
                has-icon: true;
                icon: @image-url("icons/stop.svg");
                tone: Theme.danger;
                enabled: root.interrupting;
                tip: root.stop-hint;
                clicked => { root.stop(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Btn {
                text: "Replay";
                has-icon: true;
                icon: @image-url("icons/play.svg");
                tone: Theme.accent;
                enabled: root.can-replay;
                tip: "Run this flow in Edge";
                clicked => { root.replay(); }
            }
            Btn {
                text: "Export spec";
                has-icon: true;
                icon: @image-url("icons/download.svg");
                tone: Theme.text-dim;
                enabled: root.can-export;
                tip: "Write a Playwright test for this flow";
                clicked => { root.export-spec(); }
            }
        }
        if root.has-session: VerticalLayout {
            spacing: 2px;
            Text { text: root.session-name; color: Theme.text; font-size: 12.5px; font-weight: 600; overflow: elide; }
            Text { text: root.session-summary; color: root.session-summary-tone; font-size: 11.5px; }
            Text { text: root.filed-under; color: Theme.text-dim; font-size: 11.5px; overflow: elide; }
        }
        if !root.has-session: Text { text: "No session yet."; color: Theme.text-dim; font-size: 11.5px; }

        Divider { }
        Field {
            text <=> root.search;
            placeholder: "Search recordings and folders";
            label: "Search recordings and folders";
            edited(t) => { root.search-edited(t); }
        }

        // ---- the tree ----
        HorizontalLayout {
            spacing: 4px;
            Label { text: "Recordings and folders"; vertical-alignment: center; horizontal-stretch: 1; }
            Btn {
                compact: true;
                has-icon: true;
                icon: @image-url("icons/plus.svg");
                tone: Theme.text-dim;
                tip: "New folder";
                clicked => { root.new-folder(); }
            }
            Btn {
                compact: true;
                has-icon: true;
                icon: @image-url("icons/refresh.svg");
                tone: Theme.text-dim;
                tip: "Reload from disk";
                clicked => { root.reload(); }
            }
        }
        if root.folder-draft-open: HorizontalLayout {
            spacing: 4px;
            Field {
                text <=> root.folder-draft-name;
                placeholder: root.folder-draft-renaming ? "Rename" : "Folder name";
                label: root.folder-draft-renaming ? "Rename" : "Folder name";
                horizontal-stretch: 1;
                edited(t) => { root.folder-draft-edited(t); }
                accepted => { root.folder-draft-save(); }
            }
            Btn { text: "Save"; compact: true; enabled: root.folder-draft-name != ""; clicked => { root.folder-draft-save(); } }
            Btn {
                compact: true;
                has-icon: true;
                icon: @image-url("icons/close.svg");
                tone: Theme.text-dim;
                tip: "Cancel";
                clicked => { root.folder-draft-cancel(); }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            min-height: 120px;
            accessible-role: AccessibleRole.list;
            accessible-label: "Recordings and folders";
            VerticalLayout {
                alignment: start;
                spacing: 1px;
                for f in root.folders: HorizontalLayout {
                    padding-left: 2px + f.depth * 14px;
                    spacing: 2px;
                    height: 26px;
                    if !f.is-recording && f.expandable: Rectangle {
                        width: 16px;
                        accessible-role: AccessibleRole.button;
                        accessible-label: (f.expanded ? "Collapse " : "Expand ") + f.name;
                        accessible-enabled: true;
                        accessible-expandable: true;
                        accessible-expanded: f.expanded;
                        accessible-action-default => { keys.focus(); root.folder-toggle(f.id); }
                        Image {
                            source: f.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                            width: 12px; height: 12px;
                            colorize: Theme.text-dim;
                            accessible-role: AccessibleRole.none;
                        }
                        TouchArea { clicked => { keys.focus(); root.folder-toggle(f.id); } mouse-cursor: pointer; }
                        // A focus scope, so the chevron is a real button: Enter
                        // and Space work, and a screen reader can invoke it.
                        keys := FocusScope {
                            key-pressed(e) => {
                                if (e.text == Key.Return || e.text == " ") { root.folder-toggle(f.id); return accept; }
                                reject
                            }
                        }
                    }
                    if !f.is-recording && !f.empty-marker && !f.expandable: Rectangle { width: 16px; }
                    if !f.is-recording && !f.empty-marker: Pill {
                        text: f.name + (f.count > 0 ? "  " + f.count : "");
                        selected: f.selected;
                        tone: Theme.text-dim;
                        size: 12px;
                        tip: f.tip;
                        horizontal-stretch: 1;
                        clicked => { root.folder-select(f.id); }
                    }
                    // Files the open flow into this folder. Shown only when a
                    // flow is open and this is not already its folder, so the
                    // tree is where a flow is filed — no second folder list.
                    if f.file-here: Btn {
                        compact: true; has-icon: true; icon: @image-url("icons/folder.svg");
                        tone: Theme.accent; tip: "Move the open flow into " + f.name;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.folder-file(f.id); }
                    }
                    if !f.is-recording && f.renamable: Btn {
                        compact: true; has-icon: true; icon: @image-url("icons/pencil.svg");
                        tone: Theme.text-dim; tip: "Rename " + f.name;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.folder-rename(f.id); }
                    }
                    if !f.is-recording && f.nestable: Btn {
                        compact: true; has-icon: true; icon: @image-url("icons/plus.svg");
                        tone: Theme.text-dim; tip: "New sub-folder in " + f.name;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.folder-new-child(f.id); }
                    }
                    if !f.is-recording && !f.system: Btn {
                        compact: true; has-icon: true; icon: @image-url("icons/trash.svg");
                        tone: Theme.danger; tip: "Delete folder " + f.name;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.folder-delete(f.id); }
                    }
                    if f.is-recording: RecordingLeaf {
                        entry: f;
                        deletable: !root.recording-live;
                        horizontal-stretch: 1;
                        open(id) => { root.recording-open(id); }
                        delete(id) => { root.recording-delete(id); }
                    }
                    if f.empty-marker: Text {
                        text: "empty";
                        color: Theme.text-dim;
                        font-size: 11px;
                        font-italic: true;
                        vertical-alignment: center;
                        accessible-role: AccessibleRole.none;
                    }
                }
            }
        }
    }
}
